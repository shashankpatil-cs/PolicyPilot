# Backend base URL including the API prefix (API_PREFIX in backend/.env)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=RBI Intelligence AI
# localStorage key for the JWT
VITE_TOKEN_STORAGE_KEY=rbi_intelligence_token
# How often the admin dashboard refreshes while a PDF is indexing (ms)
VITE_POLL_INTERVAL_MS=3000
# Must match an origin listed in backend CORS_ORIGINS
VITE_DEV_PORT=5173
