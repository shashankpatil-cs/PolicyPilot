# =====================================================================
# RBI Intelligence AI - Backend Configuration (.env.example)
# Minimal Local PostgreSQL & JWT Auth Setup
# =====================================================================

# ---------- Local PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rbi_intelligence
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Auth (JWT) ----------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-32-plus-character-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin282005

# ---------- OpenAI API & Models ----------
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_PLANNER_MODEL=gpt-4.1-mini
OPENAI_VALIDATOR_MODEL=gpt-4.1-mini
OPENAI_AGENT_MODEL=gpt-4.1
# OPENAI_BASE_URL=
# OPENAI_TEMPERATURE=0

# ---------- Frontend / CORS ----------
CORS_ORIGINS=http://localhost:5173

# =====================================================================
# Optional Overrides (all have sensible defaults built into the app)
# =====================================================================
# APP_NAME=RBI Intelligence AI
# APP_ENV=development
# API_PREFIX=/api
# LOG_LEVEL=INFO
# PRELOAD_EMBEDDING_MODEL=false
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# AUTO_CREATE_TABLES=true
# FTS_CONFIG=english
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# RETRIEVAL_TOP_K=5
# MAX_EVIDENCE_CHUNKS=5
# VALIDATION_LLM_CHECK=false
# MAX_GENERATION_ATTEMPTS=1
# AGENT_MAX_TURNS=4
# COMPARE_TOP_K_PER_YEAR=2
# HYBRID_SEARCH=true
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=rbi-intelligence-ai
