# =====================================================================
# PolicyPilot (RBI Intelligence AI) - Backend Configuration (.env.example)
# Copy this file to `.env` and fill in your credentials.
# =====================================================================

# ---------- Local PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rbi_intelligence
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Auth (JWT) ----------
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-32-plus-character-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin282005

# ---------- OpenAI API & Models ----------
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_PLANNER_MODEL=gpt-4.1-mini
OPENAI_VALIDATOR_MODEL=gpt-4.1-mini
OPENAI_AGENT_MODEL=gpt-4.1
# OPENAI_BASE_URL=
# OPENAI_TEMPERATURE=0

# ---------- Frontend / CORS ----------
CORS_ORIGINS=http://localhost:5173

# ---------- LangSmith (Tracing, Evals & Observability) ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=PolicyPilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Embeddings (GPU / CPU Acceleration) ----------
# Set to 'cuda' for NVIDIA GPU acceleration, or 'cpu' if no CUDA GPU is available
EMBEDDING_DEVICE=cuda

# ---------- Token Optimization & Retrieval Controls ----------
# Number of chunks retrieved per search query
RETRIEVAL_TOP_K=8

# Maximum evidence chunks fed into the LLM answer prompt
MAX_EVIDENCE_CHUNKS=8

# Enable/disable secondary LLM judge call (saves ~2,000 tokens per query)
# Deterministic Python verbatim + fuzzy verification runs on every citation regardless
VALIDATION_LLM_CHECK=false

# Prevent automatic multi-pass retry loops that re-send the full prompt
MAX_GENERATION_ATTEMPTS=1

# Cap autonomous research agent turns to prevent context explosion
AGENT_MAX_TURNS=4

# Chunks retrieved per year during comparative analysis
COMPARE_TOP_K_PER_YEAR=2

# ---------- Optional Overrides ----------
# APP_NAME=RBI Intelligence AI
# APP_ENV=development
# API_PREFIX=/api
# LOG_LEVEL=INFO
# PRELOAD_EMBEDDING_MODEL=false
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# HYBRID_SEARCH=true
